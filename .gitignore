# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Datasets (licensed for research use only - never commit images or annotations)
data/*
!data/README.md

# Training state: resume checkpoints carry optimizer state and are large.
# Final inference weights (checkpoints/<experiment>.pth) are committed on purpose.
checkpoints/*_last.pth
checkpoints/*_smoke*
checkpoints/tmp/

# Generated per-image prediction dumps, dataset face thumbnails (WFLW/FairFace imagery is not
# ours to redistribute) and raw launcher captures
results/predictions/
results/dataset_samples.png
results/*_smoke*
results/logs/*.out
results/logs/*.err

# Web app galleries hold dataset images and WFLW annotations: regenerate with python -m src.export_web
web/benchmark/
web/data/wflw_benchmark.json
web/data/apac_gallery.json

# Labelling tool: APAC images to annotate (python -m src.apac_labels prepare). Labels live in data/apac_labels/
web/labeling/

# Editors / OS / local tooling
.claude/
.launch-config/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Streamlit secrets
.streamlit/secrets.toml
